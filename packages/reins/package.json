{
  "name": "reins",
  "version": "0.1.0",
  "description": "Give coding agents the reins: a tiny dev-only library to drive, inspect and debug your app",
  "license": "MIT",
  "author": "mindmakr",
  "repository": { "type": "git", "url": "git+https://github.com/mindmakr/reins.git", "directory": "packages/reins" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./stub": { "types": "./dist/stub.d.ts", "default": "./dist/stub.js" },
    "./adapters": { "types": "./dist/adapters.d.ts", "default": "./dist/adapters.js" },
    "./server": { "types": "./dist/server.d.ts", "default": "./dist/server.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "keywords": ["ai-agents", "testing", "mcp", "webmcp", "devtools"]
}

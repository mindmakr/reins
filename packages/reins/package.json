{
  "name": "@mindmakr/reins",
  "version": "0.2.0",
  "description": "Give coding agents the reins: development tools to drive, inspect and debug web and Expo apps, and a report-only flight entry for Node servers. Production builds contain no development reins; @mindmakr/reins/flight is the only part meant for production. SECURITY.md says what flight does not protect against.",
  "license": "MIT",
  "author": "mindmakr",
  "homepage": "https://mindmakr.github.io/reins/",
  "bugs": "https://github.com/mindmakr/reins/issues",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "repository": { "type": "git", "url": "git+https://github.com/mindmakr/reins.git", "directory": "packages/reins" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./stub": { "types": "./dist/stub.d.ts", "default": "./dist/stub.js" },
    "./adapters": { "types": "./dist/adapters.d.ts", "default": "./dist/adapters.js" },
    "./server": { "types": "./dist/server.d.ts", "default": "./dist/server.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" },
    "./expo": { "types": "./dist/expo.d.ts", "default": "./dist/expo.js" },
    "./expo/metro": { "types": "./dist/metro.d.ts", "default": "./dist/metro.js" },
    "./metro": { "types": "./dist/metro.d.ts", "default": "./dist/metro.js" },
    "./vite": { "types": "./dist/vite.d.ts", "default": "./dist/vite.js" },
    "./next": { "types": "./dist/next.d.ts", "default": "./dist/next.js" },
    "./next/token-route": { "types": "./dist/next-token-route.d.ts", "default": "./dist/next-token-route.js" },
    "./verify": { "types": "./dist/verify.d.ts", "default": "./dist/verify.js" },
    "./bridge": { "types": "./dist/bridge/index.d.ts", "default": "./dist/bridge/index.js" },
    "./report": { "types": "./dist/report.d.ts", "default": "./dist/report.js" },
    "./node": { "types": "./dist/node.d.ts", "default": "./dist/node.js" },
    "./flight": { "types": "./dist/flight.d.ts", "default": "./dist/flight.js" },
    "./record": { "types": "./dist/record.d.ts", "default": "./dist/record.js" },
    "./record-stub": { "types": "./dist/record-stub.d.ts", "default": "./dist/record-stub.js" }
  },
  "bin": {
    "reins": "dist/cli.js",
    "reins-verify-bundle": "dist/verify-cli.js"
  },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "next": ">=13",
    "playwright": ">=1.40",
    "react": ">=17",
    "react-native": ">=0.70"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true },
    "playwright": { "optional": true },
    "react": { "optional": true },
    "react-native": { "optional": true }
  },
  "keywords": ["ai-agents", "testing", "mcp", "webmcp", "devtools", "lucid-coding"]
}

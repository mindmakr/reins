{
  "name": "reins-monorepo",
  "private": true,
  "description": "Give coding agents the reins: a tiny dev-only library to drive, inspect and debug your web and Expo apps",
  "license": "MIT",
  "author": "mindmakr",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/reins",
    "packages/verify",
    "packages/react",
    "packages/expo",

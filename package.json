    "packages/next",
    "packages/bridge"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "typecheck": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.0"
  }
}
